# Runtime
APP_ENV=development
LOG_LEVEL=INFO
# Non-development startup rejects either switch when true.
DEVELOPMENT_FIXTURE_MODE=true
DEMO_RESET_ENABLED=true
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Server-only target for Next's same-origin API rewrite. Never add NEXT_PUBLIC_ to this name.
SIRA_API_BASE_URL=http://127.0.0.1:8000
# Public, non-secret build setting. Use fixture for explicit local UI data or api for real calls;
# the web app never falls back from one mode to the other after startup.
NEXT_PUBLIC_WEB_DATA_MODE=fixture

# Firebase Authentication. Anonymous Auth is the instant guest path; Google and
# email/password are persistent accounts. Web values are public Firebase config.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Emergency legacy guest-cookie fallback. Keep false when Firebase is configured.
GUEST_SESSION_ENABLED=false
GUEST_SESSION_SIGNING_KEY=
GUEST_SESSION_TTL_SECONDS=604800

# Production requires a stable random value of at least 32 bytes. Development uses an
# explicitly non-production fallback when this remains empty.
BROWSER_RETURN_SIGNING_KEY=
BROWSER_RETURN_TTL_SECONDS=600

# Production identity: server-side RFC 7662/OIDC token verification. Claims must include
# sub, organization_id, roles, identity_kind, party, iss, aud, exp, and optional acr/auth_time.
IDENTITY_INTROSPECTION_URL=
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=
IDENTITY_EXPECTED_ISSUER=
IDENTITY_EXPECTED_AUDIENCE=
IDENTITY_ALLOWED_ROLES=
IDENTITY_STEP_UP_ACR_VALUES=
IDENTITY_STEP_UP_MAX_AGE_SECONDS=600

# PostgreSQL is canonical. DATABASE_URL must use a non-owner login with
# NOSUPERUSER and NOBYPASSRLS; DATABASE_ADMIN_URL is only for Alembic/setup.
# Create credentials locally and do not reuse the admin login in the running app.
# These local-only values also drive Docker's idempotent role/database bootstrap.
POSTGRES_BOOTSTRAP_USER=sira
POSTGRES_BOOTSTRAP_PASSWORD=sira
SIRA_DATABASE_NAME=sira
SIRA_TEST_DATABASE_NAME=sira_test
SIRA_DB_OWNER_USER=sira_owner
SIRA_DB_OWNER_PASSWORD=change-me
SIRA_DB_RUNTIME_USER=sira_runtime
SIRA_DB_RUNTIME_PASSWORD=change-me
# Docker cannot safely URL-encode raw passwords during Compose interpolation. Keep these
# internal URLs synchronized with the role/database values above and percent-encode passwords.
SIRA_DOCKER_DATABASE_URL=postgresql+asyncpg://sira_runtime:change-me@postgres:5432/sira
SIRA_DOCKER_DATABASE_ADMIN_URL=postgresql+psycopg://sira_owner:change-me@postgres:5432/sira
DATABASE_URL=postgresql+asyncpg://sira_runtime:change-me@localhost:5432/sira
DATABASE_ADMIN_URL=postgresql+psycopg://sira_owner:change-me@localhost:5432/sira
# Tests read this from the PowerShell environment, not from this file. It must target a
# dedicated database named sira_test or sira_test_* using a bootstrap/superuser login because
# the PostgreSQL harness creates and removes isolated runtime roles; it never drops the database.
SIRA_TEST_DATABASE_ADMIN_URL=

# Senso: use four separately scoped identities. Never reuse ingestion keys in agent runtimes.
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1
SENSO_BUYER_QUERY_API_KEY=
SENSO_BUYER_INGEST_API_KEY=
SENSO_SELLER_QUERY_API_KEY=
SENSO_SELLER_INGEST_API_KEY=
SENSO_BUYER_QUERY_KEY_ID=
SENSO_SELLER_QUERY_KEY_ID=
SENSO_BUYER_FOLDER_ID=
SENSO_SELLER_FOLDER_ID=

# Prava hosted REST. The secret and one-time checkout credential are backend-only.
PRAVA_BASE_URL=
PRAVA_SECRET_KEY=
PRAVA_MERCHANT_URL=
PRAVA_CALLBACK_URL=
PRAVA_USER_EMAIL=
PRAVA_MERCHANT_COUNTRY=US
PRAVA_HOSTED_CHECKOUT_HOSTS=

# Controlled merchant / entitlement provider used by the real sandbox proof.
CONTROLLED_MERCHANT_BASE_URL=
CONTROLLED_MERCHANT_API_KEY=
CONTROLLED_MERCHANT_ID=

# Optional durable worker and model adapter. Provider credentials are never workflow inputs.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=sira-checkout
WORKER_ORGANIZATION_IDS=org_consultco
# Project-scoped name prevents a global Windows/Codex OPENAI_API_KEY from
# silently overriding the credential supplied to the API container.
SIRA_OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
