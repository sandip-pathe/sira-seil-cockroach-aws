# Runtime
APP_ENV=development
LOG_LEVEL=INFO
# Non-development startup rejects either switch when true.
DEVELOPMENT_FIXTURE_MODE=true
DEMO_RESET_ENABLED=true
PUBLIC_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# Server-only target for Next's same-origin API rewrite. Never add NEXT_PUBLIC_ to this name.
SIRA_API_BASE_URL=http://127.0.0.1:8000
# Public, non-secret build setting. Use fixture for explicit local UI data or api for real calls;
# the web app never falls back from one mode to the other after startup.
NEXT_PUBLIC_WEB_DATA_MODE=fixture
# Hosted deployment: APP_ENV=production, DEVELOPMENT_FIXTURE_MODE=false,
# DEMO_RESET_ENABLED=false, NEXT_PUBLIC_WEB_DATA_MODE=api.

# Firebase Authentication. Anonymous Auth is the instant guest path; Google and
# email/password are persistent accounts. Web values are public Firebase config.
FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Emergency legacy guest-cookie fallback. Keep false when Firebase is configured.
GUEST_SESSION_ENABLED=false
GUEST_SESSION_SIGNING_KEY=
GUEST_SESSION_TTL_SECONDS=604800

# Production requires a stable random value of at least 32 bytes. Development uses an
# explicitly non-production fallback when this remains empty.
BROWSER_RETURN_SIGNING_KEY=
BROWSER_RETURN_TTL_SECONDS=600

# Production identity: server-side RFC 7662/OIDC token verification. Claims must include
# sub, organization_id, roles, identity_kind, party, iss, aud, exp, and optional acr/auth_time.
IDENTITY_INTROSPECTION_URL=
IDENTITY_CLIENT_ID=
IDENTITY_CLIENT_SECRET=
IDENTITY_EXPECTED_ISSUER=
IDENTITY_EXPECTED_AUDIENCE=
IDENTITY_ALLOWED_ROLES=
IDENTITY_STEP_UP_ACR_VALUES=
IDENTITY_STEP_UP_MAX_AGE_SECONDS=600

# CockroachDB is the sole transactional and business-state authority.
# Local single-node development is insecure and loopback-only. Cloud must use
# sslmode=verify-full, a CA certificate, separate migration/runtime users, and
# a runtime role that does not own tenant tables.
DATABASE_URL=cockroachdb+asyncpg://sira_app@127.0.0.1:26257/sira?ssl=disable
SIRA_WORKER_DATABASE_URL=cockroachdb+asyncpg://sira_worker_app@127.0.0.1:26257/sira?ssl=disable
SIRA_CATALOG_DATABASE_URL=cockroachdb+asyncpg://sira_catalog_app@127.0.0.1:26257/sira?ssl=disable
DATABASE_ADMIN_URL=cockroachdb+psycopg://root@127.0.0.1:26257/sira?sslmode=disable
# Tests read this from the PowerShell environment and must target an isolated database.
SIRA_TEST_DATABASE_ADMIN_URL=cockroachdb+psycopg://root@127.0.0.1:26257/sira_test?sslmode=disable
SIRA_TEST_DATABASE_URL=cockroachdb+asyncpg://sira_app@127.0.0.1:26257/sira_test?ssl=disable
SIRA_TEST_WORKER_DATABASE_URL=cockroachdb+asyncpg://sira_worker_app@127.0.0.1:26257/sira_test?ssl=disable
SIRA_TEST_CATALOG_DATABASE_URL=cockroachdb+asyncpg://sira_catalog_app@127.0.0.1:26257/sira_test?ssl=disable

# AWS Bedrock and transport. Local code uses the named AWS profile; ECS uses task roles.
AWS_PROFILE=sira-hackathon
AWS_REGION=us-east-1
BEDROCK_CHAT_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
SIRA_SQS_QUEUE_URL=
SIRA_S3_EVIDENCE_BUCKET=
SIRA_S3_EVIDENCE_KMS_KEY_ID=

# Optional generic human-controlled payment handoff. The agent may open this URL
# after approval, but it never submits credentials or infers payment success.
NEXT_PUBLIC_PAYMENT_WORKSPACE_URL=

# Durable worker configuration. Provider credentials are never work-item inputs.
WORKER_ORGANIZATION_IDS=org_consultco
# Project-scoped name prevents a global Windows/Codex OPENAI_API_KEY from
# silently overriding the credential supplied to the API container.
SIRA_OPENAI_API_KEY=
SEIL_OPENAI_API_KEY=
# Optional comma-separated primary pool. The first key is used by SEIL when
# SEIL_OPENAI_API_KEY is unset. SIRA_OPENAI_API_KEY is the automatic backup
# only after the SEIL primary returns an authentication failure.
EXTRA_OPENAI_API_KEYS=
OPENAI_MODEL=gpt-5-mini
