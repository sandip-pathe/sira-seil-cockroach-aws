{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sira.local/v1/entitlement.schema.json",
  "title": "Verified entitlement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entitlement_id", "purchase_id", "merchant_order_id", "fulfillment_item_id", "line_item_id", "product_id", "product_version", "type", "subject_type", "subject_id", "quantity", "status", "verification_method", "verification_reference", "verified_at", "environment", "adapter_label", "production_success"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SemanticVersion" },
    "entitlement_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "purchase_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "merchant_order_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "fulfillment_item_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "line_item_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "product_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "product_version": { "$ref": "common.schema.json#/$defs/Identifier" },
    "type": { "type": "string", "enum": ["workspace_entitlement", "seat_entitlement"] },
    "subject_type": { "type": "string", "enum": ["organization", "team"] },
    "subject_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "quantity": { "type": "integer", "minimum": 1 },
    "status": { "const": "VERIFIED" },
    "verification_method": { "type": "string", "enum": ["merchant_api", "merchant_api_plus_access_probe"] },
    "verification_reference": { "$ref": "common.schema.json#/$defs/Identifier" },
    "verified_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "environment": { "type": "string", "enum": ["fixture", "sandbox", "production"] },
    "adapter_label": { "type": "string", "minLength": 1, "maxLength": 100 },
    "production_success": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "environment": { "const": "fixture" } }, "required": ["environment"] },
      "then": { "properties": { "production_success": { "const": false }, "adapter_label": { "const": "DEVELOPMENT_FIXTURE_NOT_PRODUCTION" } } }
    }
  ]
}
