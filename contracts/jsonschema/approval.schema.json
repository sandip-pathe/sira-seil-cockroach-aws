{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sira.local/v1/approval.schema.json",
  "title": "Exact-hash approval projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_request_id", "purchase_intent_id", "intent_hash", "status", "policy_version", "requirement_set_id", "stages", "exact_summary", "created_at", "expires_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SemanticVersion" },
    "approval_request_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "purchase_intent_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "intent_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
    "status": { "$ref": "enums.schema.json#/$defs/ApprovalStatus" },
    "policy_version": { "type": "integer", "minimum": 1 },
    "requirement_set_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "role", "status", "actor_ref", "approved_intent_hash", "recorded_at"],
        "properties": {
          "stage": { "type": "integer", "minimum": 1 },
          "role": { "$ref": "common.schema.json#/$defs/Identifier" },
          "status": { "$ref": "enums.schema.json#/$defs/ApprovalStatus" },
          "actor_ref": { "$ref": "common.schema.json#/$defs/Identifier" },
          "approved_intent_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
          "recorded_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
        }
      }
    },
    "exact_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_version", "decision_hash", "selection_id", "solution_plan_id", "merchant_id", "line_items", "merchant_subtotal", "buyer_transaction_fee", "fee_schedule_version", "tax_amount", "landed_total", "currency", "quote_id", "quote_version", "pack_id", "pack_version", "offer_id", "offer_version", "expected_fulfillment_ids"],
      "properties": {
        "decision_version": { "type": "integer", "minimum": 1 },
        "decision_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
        "selection_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "solution_plan_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "merchant_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "line_items": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/LineItem" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "type": { "const": "SIRA_TRANSACTION_FEE" },
                  "total_amount": { "const": "10.00" },
                  "schedule_version": { "const": "buyer_txn_demo_v1" }
                },
                "required": ["type", "total_amount", "schedule_version"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "type": { "const": "MERCHANT_SUBTOTAL" },
                  "total_amount": { "const": "980.00" }
                },
                "required": ["type", "total_amount"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "merchant_subtotal": { "const": "980.00" },
        "buyer_transaction_fee": { "const": "10.00" },
        "fee_schedule_version": { "const": "buyer_txn_demo_v1" },
        "tax_amount": { "const": "0.00" },
        "landed_total": { "const": "990.00" },
        "currency": { "const": "USD" },
        "quote_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "quote_version": { "type": "integer", "minimum": 1 },
        "pack_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "pack_version": { "type": "integer", "minimum": 1 },
        "offer_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "offer_version": { "type": "integer", "minimum": 1 },
        "expected_fulfillment_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Identifier" } }
      }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
