{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sira.local/v1/evidence-bundle.schema.json",
  "title": "Safe demo evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SemanticVersion" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "candidate_id", "owner_side", "visibility", "source_title", "safe_snippet", "content_id", "version_id", "fragment_hash", "assertion", "verification_state", "verification_method", "verification_scope", "reviewer_role", "verified_at", "expires_at"],
        "properties": {
          "evidence_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "candidate_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "owner_side": { "type": "string", "enum": ["seller", "platform"] },
          "visibility": { "type": "string", "enum": ["public", "buyer_after_access_check", "restricted_review_only"] },
          "source_title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "safe_snippet": { "type": "string", "minLength": 1, "maxLength": 500 },
          "content_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "version_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "fragment_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
          "assertion": { "type": "string", "minLength": 1, "maxLength": 500 },
          "verification_state": { "type": "string", "enum": ["unverified", "verified", "disputed", "expired", "revoked"] },
          "verification_method": { "type": "string", "enum": ["source_document_review", "api_probe", "merchant_order_probe", "entitlement_probe"] },
          "verification_scope": { "type": "string", "minLength": 1, "maxLength": 200 },
          "reviewer_role": { "$ref": "common.schema.json#/$defs/Identifier" },
          "verified_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
          "expires_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
        }
      }
    }
  }
}
