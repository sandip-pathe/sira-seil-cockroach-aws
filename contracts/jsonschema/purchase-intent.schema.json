{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sira.local/v1/purchase-intent.schema.json",
  "title": "Exact locked Purchase Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purchase_intent_id", "organization_id", "decision_id", "decision_version", "decision_hash", "selection_id", "solution_plan_id", "stack_patch_id", "purchase_intent_group_id", "procurement_plan_id", "procurement_gate_result_hash", "pack_id", "pack_version", "offer_id", "offer_version", "quote_id", "quote_version", "quote_expires_at", "merchant", "approved_merchant_chain_id", "amount", "currency", "line_items", "expected_fulfillments", "fulfillment_completion_policy", "buyer_legal_entity_id", "seller_contracting_entity_id", "billing_identity_id", "cost_center_id", "purchase_order_ref", "merchant_subtotal", "tax_amount", "fee_amount", "fee_schedule_version", "landed_total", "approval_policy_version", "approval_requirement_set_id", "approval_plan_hash", "intent_hash", "locked_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SemanticVersion" },
    "purchase_intent_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "organization_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "decision_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "decision_version": { "type": "integer", "minimum": 1 },
    "decision_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
    "selection_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "solution_plan_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "stack_patch_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "purchase_intent_group_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Identifier" }, { "type": "null" }] },
    "procurement_plan_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "procurement_gate_result_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
    "pack_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "pack_version": { "type": "integer", "minimum": 1 },
    "offer_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "offer_version": { "type": "integer", "minimum": 1 },
    "quote_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "quote_version": { "type": "integer", "minimum": 1 },
    "quote_expires_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "merchant": { "$ref": "common.schema.json#/$defs/Merchant" },
    "approved_merchant_chain_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "amount": { "const": "990.00" },
    "currency": { "const": "USD" },
    "line_items": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/LineItem" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": { "const": "SIRA_TRANSACTION_FEE" },
              "total_amount": { "const": "10.00" },
              "schedule_version": { "const": "buyer_txn_demo_v1" }
            },
            "required": ["type", "total_amount", "schedule_version"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "type": { "const": "MERCHANT_SUBTOTAL" },
              "total_amount": { "const": "980.00" }
            },
            "required": ["type", "total_amount"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "expected_fulfillments": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/ExpectedFulfillment" } },
    "fulfillment_completion_policy": { "const": "all_required_minimums_verified" },
    "buyer_legal_entity_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "seller_contracting_entity_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "billing_identity_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "cost_center_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "purchase_order_ref": { "type": ["string", "null"], "maxLength": 100 },
    "merchant_subtotal": { "const": "980.00" },
    "tax_amount": { "const": "0.00" },
    "fee_amount": { "const": "10.00" },
    "fee_schedule_version": { "const": "buyer_txn_demo_v1" },
    "contract_version_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "landed_total": { "const": "990.00" },
    "approval_policy_version": { "type": "integer", "minimum": 1 },
    "approval_requirement_set_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "approval_plan_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
    "intent_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
    "locked_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
