{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sira.local/v1/stackfile-lock.schema.json",
  "title": "Reconciled Stackfile lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization_id", "snapshot", "generated_at", "manifest_hash", "instances", "edges", "content_hash"],
  "properties": {
    "schema_version": { "const": "sira.ai/v1" },
    "organization_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "snapshot": { "type": "integer", "minimum": 1 },
    "generated_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
    "manifest_hash": { "$ref": "common.schema.json#/$defs/Sha256" },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "product_id", "lifecycle", "version", "serves", "integrations"],
        "properties": {
          "instance_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "product_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "lifecycle": { "type": "string", "enum": ["planned", "staged", "active", "degraded", "retiring", "retired", "cancelled", "failed"] },
          "version": { "$ref": "common.schema.json#/$defs/Identifier" },
          "serves": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Identifier" } },
          "integrations": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Identifier" } }
        }
      }
    },
    "edges": { "type": "array", "items": { "$ref": "stack-patch.schema.json#/$defs/Edge" } },
    "content_hash": { "$ref": "common.schema.json#/$defs/Sha256" }
  }
}
