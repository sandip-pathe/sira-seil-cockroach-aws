{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sira.local/v1/buyer-passport.schema.json",
  "title": "Buyer Passport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "passport_id", "organization_id", "version", "company_profile", "facts", "stakeholders", "budget", "operational_preferences", "created_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SemanticVersion" },
    "passport_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "organization_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "company_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "employee_count", "region", "business_model", "team_type"],
      "properties": {
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "employee_count": { "type": "integer", "minimum": 1 },
        "region": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "business_model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "team_type": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Fact" }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Stakeholder" }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling_amount", "currency", "horizon_days", "valid_until", "owner_role", "cost_center_id"],
      "properties": {
        "ceiling_amount": { "$ref": "common.schema.json#/$defs/DecimalAmount" },
        "currency": { "$ref": "common.schema.json#/$defs/Currency" },
        "horizon_days": { "type": "integer", "minimum": 1 },
        "valid_until": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "owner_role": { "const": "budget_owner" },
        "cost_center_id": { "$ref": "common.schema.json#/$defs/Identifier" }
      }
    },
    "operational_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admin_capacity", "required_integrations", "identity_preference", "maximum_deployment_days"],
      "properties": {
        "admin_capacity": { "type": "string", "enum": ["low", "medium", "high"] },
        "required_integrations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/Identifier" } },
        "identity_preference": { "type": "string", "enum": ["native", "add_on_allowed", "manual_allowed"] },
        "maximum_deployment_days": { "type": "integer", "minimum": 0 }
      }
    },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  },
  "$defs": {
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "organization_id", "subject_type", "subject_id", "field", "operator", "value", "kind", "stakeholder_role", "source", "verification", "valid_from", "valid_until", "sensitivity", "confidence"],
      "properties": {
        "fact_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "organization_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "subject_type": { "type": "string", "enum": ["company", "policy", "workflow", "stack", "budget", "authority"] },
        "subject_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{2,127}$" },
        "operator": { "type": "string", "enum": ["eq", "neq", "in", "not_in", "contains", "contains_all", "gte", "lte", "gt", "lt", "exists"] },
        "value": {
          "oneOf": [
            { "type": "string" },
            { "type": "boolean" },
            { "type": "integer" },
            { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
          ]
        },
        "kind": { "type": "string", "enum": ["hard_constraint", "preference", "context", "authority"] },
        "stakeholder_role": { "$ref": "common.schema.json#/$defs/Identifier" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "adapter_mode", "content_id", "version_id", "chunk_index", "retrieved_at"],
          "properties": {
            "provider": { "type": "string", "enum": ["senso", "fixture", "admin_input", "stackfile"] },
            "adapter_mode": { "type": "string", "enum": ["PRODUCTION_PROVIDER", "DEVELOPMENT_FIXTURE", "MANUAL_INPUT", "CANONICAL_STACKFILE", "SYSTEM_OBSERVATION"] },
            "content_id": { "$ref": "common.schema.json#/$defs/Identifier" },
            "version_id": { "$ref": "common.schema.json#/$defs/Identifier" },
            "chunk_index": { "type": "integer", "minimum": 0 },
            "retrieved_at": { "$ref": "common.schema.json#/$defs/Timestamp" },
            "evidence_hash": { "$ref": "common.schema.json#/$defs/Sha256" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "verified_by", "verified_at"],
          "properties": {
            "status": { "type": "string", "enum": ["human_approved", "approved_policy_source", "platform_verified", "proposed"] },
            "method": { "type": "string", "minLength": 1, "maxLength": 100 },
            "verified_by": { "$ref": "common.schema.json#/$defs/Identifier" },
            "verified_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
          }
        },
        "valid_from": { "$ref": "common.schema.json#/$defs/Timestamp" },
        "valid_until": { "oneOf": [{ "$ref": "common.schema.json#/$defs/Timestamp" }, { "type": "null" }] },
        "sensitivity": { "type": "string", "enum": ["internal", "confidential", "restricted"] },
        "confidence": { "type": "string", "enum": ["confirmed", "measured", "observed", "inferred"] }
      }
    },
    "Stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "actor_ref", "authorities"],
      "properties": {
        "role": { "$ref": "common.schema.json#/$defs/Identifier" },
        "actor_ref": { "$ref": "common.schema.json#/$defs/Identifier" },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["submit_request", "set_outcome_weights", "approve_security", "approve_legal", "approve_budget", "approve_stack_patch", "authenticate_payment"] }
        }
      }
    }
  }
}
