{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sira.local/v1/calibration.schema.json",
  "title": "Calibration run and unaccepted Purchase Brief proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calibration_run_id", "request_id", "base_purchase_brief_id", "base_purchase_brief_version", "examples", "proposal", "ranking_effect", "created_at"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SemanticVersion" },
    "calibration_run_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "request_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "base_purchase_brief_id": { "$ref": "common.schema.json#/$defs/Identifier" },
    "base_purchase_brief_version": { "type": "integer", "minimum": 1 },
    "examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "expected_result", "actual_result", "matched"],
        "properties": {
          "candidate_id": { "$ref": "common.schema.json#/$defs/Identifier" },
          "expected_result": { "type": "string", "enum": ["FAIL", "CURRENT_APPROACH", "QUALIFY"] },
          "actual_result": { "type": "string", "enum": ["FAIL", "CURRENT_APPROACH", "QUALIFY"] },
          "matched": { "type": "boolean" }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "status", "proposed_purchase_brief_version", "changes", "authorized_acceptance_required"],
      "properties": {
        "proposal_id": { "$ref": "common.schema.json#/$defs/Identifier" },
        "status": { "const": "PENDING_AUTHORIZED_ACCEPTANCE" },
        "proposed_purchase_brief_version": { "type": "integer", "minimum": 2 },
        "changes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "authorized_acceptance_required": { "const": true }
      }
    },
    "ranking_effect": { "const": false },
    "created_at": { "$ref": "common.schema.json#/$defs/Timestamp" }
  }
}
